<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Slopfin.UI.ViewModels"
             xmlns:v="using:Slopfin.UI.Views"
             xmlns:c="using:Slopfin.UI.Controls"
             x:Class="Slopfin.UI.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <UserControl.Styles>
    <!-- Rail floats over content and widens on hover/focus, so content never re-lays out. -->
    <Style Selector="Border#Rail">
      <Setter Property="Width" Value="80" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#Rail.expanded">
      <Setter Property="Width" Value="250" />
      <Setter Property="BoxShadow" Value="12 0 40 0 #66000000" />
    </Style>
    <Style Selector="Border#Rail TextBlock.label">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#Rail.expanded TextBlock.label">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:NavItemViewModel">
      <Button Classes="nav" Classes.selected="{Binding IsSelected}" Command="{Binding GoCommand}" Margin="0,2" ToolTip.Tip="{Binding Label}">
        <StackPanel Orientation="Horizontal" Spacing="18">
          <PathIcon Data="{Binding IconKey, Converter={x:Static v:IconConverter.Instance}}" />
          <TextBlock Classes="label" Text="{Binding Label}" VerticalAlignment="Center" FontSize="15" TextTrimming="CharacterEllipsis" Width="150" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid>
    <!-- Page area -->
    <TransitioningContentControl x:Name="PageHost" Content="{Binding Current}" Margin="80,0,0,0" Focusable="True">
      <TransitioningContentControl.PageTransition>
        <CrossFade Duration="0:0:0.18" />
      </TransitioningContentControl.PageTransition>
    </TransitioningContentControl>

    <!-- Back button (floating) -->
    <Button Classes="glass icon" Command="{Binding GoBackCommand}" IsVisible="{Binding CanGoBack}"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="100,36,0,0" ZIndex="5" ToolTip.Tip="Back (Esc)">
      <PathIcon Data="{StaticResource Icon.Back}" />
    </Button>

    <!-- Navigation rail -->
    <Border x:Name="Rail" HorizontalAlignment="Left" Background="{DynamicResource BgAltBrush}" ZIndex="10"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*,Auto" Margin="12,40,12,18">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="10,0,0,26">
          <v:BrandMark Scale="0.75" ShowWordmark="False" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Classes="label" Text="Slopfin" FontSize="20" FontWeight="ExtraBold" />
            <TextBlock Classes="label muted caption" Text="{Binding VersionText}" Margin="1,-2,0,0" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding NavTop}" />
            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="8,10" />
            <ItemsControl ItemsSource="{Binding NavLibraries}" />
            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="8,10" />
            <ItemsControl ItemsSource="{Binding NavBottom}" />
          </StackPanel>
        </ScrollViewer>

        <!-- Profile -->
        <StackPanel Grid.Row="2" Spacing="4">
          <StackPanel IsVisible="{Binding IsAccountMenuOpen}" Spacing="2" Margin="0,0,0,6">
            <Button Classes="nav" Command="{Binding SwitchUserCommand}">
              <StackPanel Orientation="Horizontal" Spacing="18">
                <PathIcon Data="{StaticResource Icon.Swap}" />
                <TextBlock Classes="label" Text="Switch profile" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="nav" Command="{Binding SignOutCommand}">
              <StackPanel Orientation="Horizontal" Spacing="18">
                <PathIcon Data="{StaticResource Icon.Logout}" />
                <TextBlock Classes="label" Text="Sign out &amp; forget" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Button Classes="nav" Command="{Binding ToggleAccountMenuCommand}" Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Border Width="36" Height="36" CornerRadius="999" ClipToBounds="True" Background="{DynamicResource AccentGradientBrush}">
                <Grid>
                  <TextBlock Text="{Binding UserInitial}" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Classes="fade" Opacity="0" Stretch="UniformToFill" c:ImageLoader.DecodeWidth="72" c:ImageLoader.Source="{Binding AvatarUrl}" />
                </Grid>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="label" Text="{Binding UserName}" FontWeight="SemiBold" />
                <TextBlock Classes="label muted caption" Text="{Binding ServerName}" />
              </StackPanel>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
