<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nettle.UI.ViewModels"
             xmlns:v="using:Nettle.UI.Views"
             x:Class="Nettle.UI.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource BgBrush}">
  <!-- "motion" turns on the fades / slides in Controls.axaml (off with Settings → Reduce motion). -->
  <Grid Classes.motion="{Binding MotionEnabled}">
    <!-- Soft ambient glow behind everything -->
    <Border Background="{DynamicResource AmbientGlowBrush}" IsHitTestVisible="False" />

    <TransitioningContentControl x:Name="RootHost" Content="{Binding Root}" IsVisible="{Binding !IsPlayerOpen}">
      <TransitioningContentControl.PageTransition>
        <CrossFade Duration="0:0:0.28" />
      </TransitioningContentControl.PageTransition>
    </TransitioningContentControl>

    <ContentControl Content="{Binding Player}" IsVisible="{Binding IsPlayerOpen}" />

    <!-- Splash -->
    <Grid IsVisible="{Binding IsStarting}" Background="{DynamicResource BgBrush}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
        <v:BrandMark HorizontalAlignment="Center" Scale="1.6" />
        <Arc Classes="spin" Width="34" Height="34" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding StartupText}" Classes="muted" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- One-time "add to applications menu?" card (Linux AppImage) -->
    <Border IsVisible="{Binding IsMenuPromptVisible}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,32"
            MaxWidth="400" Background="{DynamicResource SurfaceHighBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
            CornerRadius="16" Padding="22,18" BoxShadow="0 16 40 0 #80000000">
      <StackPanel Spacing="10">
        <TextBlock Text="Add Nettle to your applications menu?" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="So you can launch it like any other app, with its icon. Nothing is installed system-wide, and you can remove it in Settings." />
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
          <Button Classes="primary" Content="Add to menu" Command="{Binding AcceptMenuPromptCommand}" />
          <Button Content="Not now" Command="{Binding DeclineMenuPromptCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Toast -->
    <Border IsVisible="{Binding IsToastVisible}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,48"
            Background="{DynamicResource SurfaceHighBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
            CornerRadius="999" Padding="22,12" BoxShadow="0 10 30 0 #66000000">
      <TextBlock Text="{Binding ToastText}" FontWeight="SemiBold" />
    </Border>
  </Grid>
</UserControl>
