# ------------------------------------------------------------------
# ALLOWLIST: only Nettle's own files are ever tracked.
# Everything else in this folder (other projects, notes, scratch files,
# build output) is ignored automatically. To add a NEW top-level file
# or folder to the repo, add a "!/name" line below.
# ------------------------------------------------------------------
/*

!/.gitignore
!/.githooks/
!/.github/
!/src/
!/tests/
!/docs/
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/Nettle.slnx
!/Directory.Build.props
!/Directory.Build.targets
!/dotnet-tools.json
!/build-release.ps1
!/get-libmpv.ps1
!/android/
!/tools/

# Build output inside the allowed folders
bin/
obj/
*.user
*.suo
*.DotSettings.user
TestResults/

# Android (Gradle) build output and machine-local files
.gradle/
android/**/build/
android/local.properties
android/.kotlin/
android/.idea/
*.apk
*.aab

# tools/avsync: the measuring script is tracked; its full-screen white test clips (large, and flashing) are not.
tools/avsync/clips/
__pycache__/
