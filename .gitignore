# ------------------------------------------------------------------
# ALLOWLIST: only Slopfin's own files are ever tracked.
# Everything else in this folder (other projects, notes, scratch files,
# build output) is ignored automatically. To add a NEW top-level file
# or folder to the repo, add a "!/name" line below.
# ------------------------------------------------------------------
/*

!/.gitignore
!/.githooks/
!/.github/
!/src/
!/tests/
!/docs/
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/Slopfin.slnx
!/Directory.Build.props
!/Directory.Build.targets
!/dotnet-tools.json
!/build-release.ps1
!/get-libmpv.ps1

# Build output inside the allowed folders
bin/
obj/
*.user
*.suo
*.DotSettings.user
TestResults/
