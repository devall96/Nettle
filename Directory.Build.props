<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.3</Version>
    <Product>Nettle</Product>
    <Authors>Nettle contributors</Authors>
    <Copyright>Copyright (c) Nettle contributors</Copyright>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <!-- Release label shown next to the version in the app (sidebar, Settings → About), e.g.
       "parity hotfix". Leave empty for an ordinary release. -->
  <PropertyGroup>
    <NettleReleaseLabel></NettleReleaseLabel>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="NettleReleaseLabel" Value="$(NettleReleaseLabel)" />
  </ItemGroup>
  <!-- Privacy: compiled files (and their .pdb debug info) record where they were built. Map this
       checkout's folder to "/_/" so no builder's user name or folder layout ends up in what's handed
       out (stack traces in crash.log still show file names and line numbers). Deterministic too. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Deterministic>true</Deterministic>
    <!-- Maps the source root to /_/ everywhere, the Source Link data in the .pdb files included. -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <!-- Debug info inside each .dll: no separate .pdb path (Avalonia rewrites Nettle.UI.dll after compiling,
         which put the original .pdb's full path back). -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <!-- -p:NettleDevHooks=true: keep the NETTLE_DEV_* developer hooks in a Release build (on-device
       performance testing only; never for builds that are handed out). -->
  <PropertyGroup Condition="'$(NettleDevHooks)' == 'true'">
    <DefineConstants>$(DefineConstants);NETTLE_DEV</DefineConstants>
  </PropertyGroup>
</Project>
