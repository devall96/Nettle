<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.5.0</Version>
    <Product>Nettle</Product>
    <Authors>Nettle contributors</Authors>
    <Copyright>Copyright (c) Nettle contributors</Copyright>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <!-- Release label shown next to the version in the app (sidebar, Settings → About), e.g.
       "parity hotfix". Leave empty for an ordinary release. -->
  <PropertyGroup>
    <NettleReleaseLabel></NettleReleaseLabel>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="NettleReleaseLabel" Value="$(NettleReleaseLabel)" />
  </ItemGroup>
  <!-- -p:NettleDevHooks=true: keep the NETTLE_DEV_* developer hooks in a Release build (on-device
       performance testing only; never for builds that are handed out). -->
  <PropertyGroup Condition="'$(NettleDevHooks)' == 'true'">
    <DefineConstants>$(DefineConstants);NETTLE_DEV</DefineConstants>
  </PropertyGroup>
</Project>
